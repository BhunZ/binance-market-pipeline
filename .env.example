# Copy to .env and fill in. This file IS committed, so it must never hold a real value.
# Write NAME=value with no spaces around the '=' — docker compose rejects the whole file
# over one stray space, and names a variable rather than the rule it broke.

# ── Object storage (Cloudflare R2, S3-compatible) ────────────────────────────
# Bronze partitions land here. Leave these empty and everything still runs, writing to
# data/ under the identical layout — a cloud account is not a condition of running the DAG.
#
# R2_BUCKET is the bucket NAME alone. Cloudflare's dashboard shows an S3 endpoint with the
# bucket already appended, so it is easy to paste the whole URL by mistake.
#
# The API token must be Object Read & Write. A read-only token lists a bucket perfectly well,
# so a connectivity check passes and the first upload is what fails.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Binance ──────────────────────────────────────────────────────────────────
# Public market data needs no key. Override only to point at a different host; the default
# data-api.binance.vision is read-only and not regionally blocked the way api.binance.com is,
# which matters when this runs from a cloud VM.
# BINANCE_BASE=https://data-api.binance.vision
